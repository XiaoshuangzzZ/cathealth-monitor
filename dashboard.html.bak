                        </div>
                        
                        <button class="btn btn-primary" onclick="saveHealthDetail()" style="width: 100%; padding: 15px;">
                            <i class="fas fa-save"></i> 保存健康信息
                        </button>
                        
                        <button class="btn btn-secondary" onclick="closeHealthDetail()" style="width: 100%; padding: 15px; margin-top: 10px;">
                            <i class="fas fa-times"></i> 返回猫咪档案
                        </button>
                    </div>
                </div>
            </div>


            <!-- 健康评估问卷页面 -->
            <div id="health-survey-page" class="page-content">
                        <div class="welcome-banner">
        <!-- 强制居中容器 -->
                  <div style="display: flex; justify-content: center; align-items: center; flex-direction: column; width: 100%;">
                  <h2 style="text-align: center; width: 100%; margin: 0 auto;">猫咪健康评估问卷</h2>
                  <p style="text-align: center; width: 100%; margin: 10px auto 0; max-width: 600px;">
                      请根据您猫咪的实际情况填写，获取个性化健康报告
                  </p>
              </div>
          </div>

                    <div class="analysis-section">
                   <form id="health-survey-form">
                        <!-- 基本信息 -->
                <div class="survey-section">
                <div class="section-title">
                    <i class="fas fa-cat"></i>
                           基本信息
                       </div>
                
                <div class="form-group">
                    <label>选择要评估的猫咪</label>
                    <select id="survey-pet-select" class="form-control" required>
                        <option value="">请选择猫咪</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>当前体重 (kg)</label>
                    <input type="number" id="survey-weight" class="form-control" placeholder="例如: 4.2" step="0.1" min="1" max="20" required>
                </div>
            </div>

            <!-- 饮食状况 -->
            <div class="survey-section">
                <div class="section-title">
                    <i class="fas fa-utensils"></i>
              饮食状况
                </div>
                
                <div class="survey-question">
                    <label>1. 猫咪的食欲如何？</label>
                    <div class="options-grid">
                        <label class="option-item">
                            <input type="radio" name="appetite" value="excellent" required>
                            <span>非常好（主动讨食，吃完所有食物）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="appetite" value="good">
                            <span>良好（正常进食，偶尔剩食）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="appetite" value="fair">
                            <span>一般（食欲减退，经常剩食）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="appetite" value="poor">
                            <span>差（几乎不进食）</span>
                        </label>
                    </div>
                </div>

                <div class="survey-question">
                    <label>2. 每日饮水量如何？</label>
                    <div class="options-grid">
                        <label class="option-item">
                            <input type="radio" name="water" value="excellent" required>
                            <span>充足（主动频繁喝水）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="water" value="good">
                            <span>正常（每天喝水数次）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="water" value="fair">
                            <span>偏少（很少主动喝水）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="water" value="poor">
                            <span>极少（几乎不喝水）</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- 活动水平 -->
            <div class="survey-section">
                <div class="section-title">
                    <i class="fas fa-running"></i>
              活动水平
                </div>
                
                <div class="survey-question">
                    <label>3. 猫咪的活动量如何？</label>
                    <div class="options-grid">
                        <label class="option-item">
                            <input type="radio" name="activity" value="excellent" required>
                            <span>非常活跃（经常跑跳玩耍）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="activity" value="good">
                            <span>活跃（每天有固定活动时间）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="activity" value="fair">
                            <span>一般（偶尔活动，大部分时间休息）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="activity" value="poor">
                            <span>懒散（几乎不活动）</span>
                        </label>
                    </div>
                </div>

                <div class="survey-question">
                    <label>4. 玩耍时的精神状态？</label>
                    <div class="options-grid">
                        <label class="option-item">
                            <input type="radio" name="energy" value="excellent" required>
                            <span>精力充沛（玩耍时间长）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="energy" value="good">
                            <span>精神良好（有兴趣玩耍）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="energy" value="fair">
                            <span>精神一般（玩耍时间短）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="energy" value="poor">
                            <span>精神萎靡（对玩耍没兴趣）</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- 排泄状况 -->
            <div class="survey-section">
                <div class="section-title">
                    <i class="fas fa-toilet"></i>
                   排泄状况
                </div>
                
                <div class="survey-question">
                    <label>5. 排便情况如何？</label>
                    <div class="options-grid">
                        <label class="option-item">
                            <input type="radio" name="poop" value="excellent" required>
                            <span>正常（成型，颜色正常）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="poop" value="good">
                            <span>基本正常（偶尔软便）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="poop" value="fair">
                            <span>异常（经常软便或便秘）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="poop" value="poor">
                            <span>严重异常（腹泻或便血）</span>
                        </label>
                    </div>
                </div>

                <div class="survey-question">
                    <label>6. 排尿情况如何？</label>
                    <div class="options-grid">
                        <label class="option-item">
                            <input type="radio" name="urine" value="excellent" required>
                            <span>正常（频率颜色正常）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="urine" value="good">
                            <span>基本正常（偶尔异常）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="urine" value="fair">
                            <span>异常（频率或颜色异常）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="urine" value="poor">
                            <span>严重异常（尿血或排尿困难）</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- 行为表现 -->
            <div class="survey-section">
                <div class="section-title">
                    <i class="fas fa-heart"></i>
 行为表现
                </div>
                
                <div class="survey-question">
                    <label>7. 猫咪的睡眠质量？</label>
                    <div class="options-grid">
                        <label class="option-item">
                            <input type="radio" name="sleep" value="excellent" required>
                            <span>很好（睡眠安稳）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="sleep" value="good">
                            <span>良好（偶尔惊醒）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="sleep" value="fair">
                            <span>一般（睡眠不安）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="sleep" value="poor">
                            <span>差（失眠或过度睡眠）</span>
                        </label>
                    </div>
                </div>

                <div class="survey-question">
                    <label>8. 与人的互动情况？</label>
                    <div class="options-grid">
                        <label class="option-item">
                            <input type="radio" name="interaction" value="excellent" required>
                            <span>非常友好（主动亲近）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="interaction" value="good">
                            <span>友好（回应互动）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="interaction" value="fair">
                            <span>一般（偶尔躲避）</span>
                        </label>
                        <label class="option-item">
                            <input type="radio" name="interaction" value="poor">
                            <span>差（经常躲藏或攻击）</span>
                        </label>
                    </div>
                </div>
            </div>

            <div style="text-align: center; margin-top: 30px;">
                <button type="submit" class="btn btn-primary" style="padding: 15px 30px; font-size: 1.1rem;">
                    <i class="fas fa-chart-bar"></i>
 生成健康报告
                </button>
            </div>
        </form>

        <!-- 结果显示区域 -->
        <div id="survey-results" class="detection-results" style="display: none;">
            <!-- 结果会动态填充 -->
        </div>
    </div>
            </div>

            <!-- 添加猫咪模态框 -->
            <div id="add-pet-modal" class="modal">
                <div class="modal-content">
                    <div class="modal-icon">
                        <i class="fas fa-cat"></i>
                    </div>
                    <h2>添加新猫咪</h2>
                    
                    <div style="text-align: left; margin: 16px 0;">
                        <div class="form-group">
                            <label>猫咪名字 *</label>
                            <input type="text" id="new-pet-name" class="form-control" placeholder="输入猫咪名字" required>
                        </div>
                        <div class="form-group">
                            <label>猫咪照片</label>
                            <div class="upload-area" id="pet-photo-upload-area" style="margin: 8px 0; padding: 20px; min-height: 120px;">
                                <div class="upload-icon">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                </div>
                                <h4>点击上传猫咪照片</h4>
                                <p>支持 JPG、PNG 格式</p>
                                <input type="file" id="pet-photo-upload" accept="image/*">
                            </div>
                            <div class="image-preview" id="pet-image-preview" style="display: none; margin-top: 10px;">
                                <img id="pet-preview-img" src="" alt="猫咪照片预览" style="max-width: 200px; border-radius: 10px;">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>品种</label>
                            <input type="text" id="new-pet-breed" class="form-control" placeholder="例如: 英国短毛猫">
                        </div>

                        <div class="form-group">
                            <label>年龄</label>
                            <input type="text" id="new-pet-age" class="form-control" placeholder="例如: 3岁">
                        </div>

                        <div class="form-group">
                            <label>体重</label>
                            <input type="text" id="new-pet-weight" class="form-control" placeholder="例如: 4.2kg">
                        </div>

                        <div class="form-group">
                            <label>性别</label>
                            <select id="new-pet-gender" class="form-control">
                                <option value="">选择性别</option>
                                <option value="公">公</option>
                                <option value="母">母</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>备注</label>
                            <textarea id="new-pet-notes" class="form-control" placeholder="特殊需求、病史等"></textarea>
                        </div>
                    </div>

                    <div class="modal-buttons">
                        <button class="btn btn-primary" onclick="addNewPet()">
                            <i class="fas fa-save"></i> 添加猫咪
                        </button>
                        <button class="btn btn-secondary" onclick="closeAddPetModal()">
                            取消
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

<script>
// ==================== 醫院詳情側邊欄控制 ====================

/**
 * 打開醫院詳情側邊欄
 * @param {Object} hospital - 醫院數據對象
 */
function openHospitalDrawer(hospital) {
    if (!hospital) return;

    // 填充數據
    document.getElementById('drawer-hospital-name').textContent = hospital.name || '醫院名稱';
    document.getElementById('drawer-hospital-name-en').textContent = hospital.nameEn || '';
    document.getElementById('drawer-hospital-address').textContent = hospital.address || '-';
    document.getElementById('drawer-hospital-phone').textContent = hospital.phone || '-';
    document.getElementById('drawer-hospital-hours').textContent = hospital.hours || '-';

    // 填充服務標籤
    const servicesContainer = document.getElementById('drawer-hospital-services');
    servicesContainer.innerHTML = '';
    if (hospital.services && hospital.services.length > 0) {
        hospital.services.forEach(service => {
            const tag = document.createElement('span');
            tag.className = 'service-tag';
            tag.textContent = service;
            servicesContainer.appendChild(tag);
        });
    }

    // 設置導航鏈接
    const navBtn = document.getElementById('drawer-nav-btn');
    if (hospital.location) {
        const lat = hospital.location.lat;
        const lng = hospital.location.lng;
        // 使用騰訊地圖導航鏈接
        navBtn.href = `https://apis.map.qq.com/uri/v1/marker?marker=coord:${lat},${lng};title=${encodeURIComponent(hospital.name)};addr=${encodeURIComponent(hospital.address)}`;
    } else {
        navBtn.href = '#';
    }

    // 顯示側邊欄和遮罩
    document.getElementById('hospital-detail-drawer').classList.add('open');
    document.getElementById('hospital-drawer-overlay').classList.add('open');
    document.body.style.overflow = 'hidden'; // 防止背景滾動
}

/**
 * 關閉醫院詳情側邊欄
 */
function closeHospitalDrawer() {
    document.getElementById('hospital-detail-drawer').classList.remove('open');
    document.getElementById('hospital-drawer-overlay').classList.remove('open');
    document.body.style.overflow = ''; // 恢復滾動
}

// 監聽 ESC 鍵關閉側邊欄
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeHospitalDrawer();
    }
});
</script>

<script>
    // 註冊 Service Worker（PWA 離線支持）
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('service-worker.js')
            .then(function(reg) {
                console.log('Service Worker 註冊成功:', reg.scope);
            })
            .catch(function(err) {
                console.error('Service Worker 註冊失敗:', err);
            });
    }
</script>

</body>
</html>