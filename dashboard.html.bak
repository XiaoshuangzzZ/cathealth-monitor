// ==================== 健康调查问卷功能 ====================
function initHealthSurvey() {
    const form = document.getElementById('health-survey-form');
    const petSelect = document.getElementById('survey-pet-select');
    
    // 填充猫咪选择下拉框
    function populatePetSelect() {
        petSelect.innerHTML = '<option value="">请选择猫咪</option>';
        allPets.forEach(pet => {
            const option = document.createElement('option');
            option.value = pet.id;
            option.textContent = `${pet.name} (${pet.breed || '未知品种'})`;
            petSelect.appendChild(option);
        });
    }
    
    // 表单提交处理
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        calculateHealthScore();
    });
    
    // 猫咪选择变化时更新体重
    petSelect.addEventListener('change', function() {
        const petId = this.value;
        const pet = allPets.find(p => p.id === petId);
        if (pet && pet.weight) {
            document.getElementById('survey-weight').value = pet.weight;
        }
    });
    
    populatePetSelect();
}

// 计算健康分数
function calculateHealthScore() {
    const formData = new FormData(document.getElementById('health-survey-form'));
    const petId = document.getElementById('survey-pet-select').value;
    const weight = parseFloat(document.getElementById('survey-weight').value);
    
    if (!petId) {
        alert('请选择要评估的猫咪');
        return;
    }
    
    const pet = allPets.find(p => p.id === petId);
    if (!pet) return;
    
    // 评分标准
    const scoreMap = {
        'excellent': 100,
        'good': 80,
        'fair': 60,
        'poor': 40
    };
    
    // 计算各项分数
    const appetiteScore = scoreMap[formData.get('appetite')] || 0;
    const waterScore = scoreMap[formData.get('water')] || 0;
    const activityScore = scoreMap[formData.get('activity')] || 0;
    const energyScore = scoreMap[formData.get('energy')] || 0;
    const poopScore = scoreMap[formData.get('poop')] || 0;
    const urineScore = scoreMap[formData.get('urine')] || 0;
    const sleepScore = scoreMap[formData.get('sleep')] || 0;
    const interactionScore = scoreMap[formData.get('interaction')] || 0;
    
    // 计算综合分数
    const dietScore = Math.round((appetiteScore + waterScore) / 2);
    const activityLevel = Math.round((activityScore + energyScore) / 2);
    const overallHealth = Math.round((
        appetiteScore + waterScore + activityScore + energyScore + 
        poopScore + urineScore + sleepScore + interactionScore
    ) / 8);
    
    // 更新主页数据
    updateDashboardStats(overallHealth, dietScore, activityLevel, weight);
    
    // 显示结果
    showSurveyResults(overallHealth, dietScore, activityLevel, weight, pet.name, pet.id);
}

// 更新主页统计数据显示真实数据
function updateDashboardStats(healthIndex, dietStatus, activityLevel, avgWeight) {
    document.getElementById('health-index').textContent = healthIndex + '%';
    document.getElementById('health-index').className = 'stat-value';
    
    document.getElementById('diet-status').textContent = dietStatus + '%';
    document.getElementById('diet-status').className = 'stat-value';
    
    document.getElementById('activity-level').textContent = activityLevel + '%';
    document.getElementById('activity-level').className = 'stat-value';
    
    document.getElementById('avg-weight').textContent = avgWeight + 'kg';
    document.getElementById('avg-weight').className = 'stat-value';
}

// 全局變量存儲當前評估數據
let currentSurveyData = null;

// 显示调查结果
function showSurveyResults(overallHealth, dietScore, activityLevel, weight, petName, petId) {
    const resultsDiv = document.getElementById('survey-results');

    // 生成建议
    const recommendations = generateRecommendations(overallHealth, dietScore, activityLevel);

    // 保存到全局變量
    currentSurveyData = {
        petId: petId,
        petName: petName,
        overallHealth: overallHealth,
        dietScore: dietScore,
        activityLevel: activityLevel,
        weight: weight,
        recommendations: recommendations,
        timestamp: new Date().toISOString()
    };

    resultsDiv.innerHTML = `
        <h3 style="text-align: center; margin-bottom: 30px; color: var(--dark);">
            <i class="fas fa-file-medical-alt"></i> ${petName}的健康评估报告
        </h3>

        <div class="result-grid">
            <div class="result-item">
                <div class="result-value" style="color: ${getHealthColor(overallHealth)};">${overallHealth}%</div>
                <div class="result-label">整体健康指数</div>
            </div>
            <div class="result-item">
                <div class="result-value" style="color: ${getHealthColor(dietScore)};">${dietScore}%</div>
                <div class="result-label">饮食状态</div>
            </div>
            <div class="result-item">
                <div class="result-value" style="color: ${getHealthColor(activityLevel)};">${activityLevel}%</div>
                <div class="result-label">活动水平</div>
            </div>
            <div class="result-item">
                <div class="result-value">${weight}kg</div>
                <div class="result-label">当前体重</div>
            </div>
        </div>

        <div style="margin-top: 30px;">
            <h4 style="margin-bottom: 15px; color: var(--dark);">
                <i class="fas fa-lightbulb"></i> 健康建议
            </h4>
            ${recommendations.map(rec => `
                <div class="recommendation-item ${rec.type || ''}">
                    <strong>${rec.title}</strong>
                    <p style="margin: 5px 0 0 0;">${rec.description}</p>
                </div>
            `).join('')}
        </div>

        <div style="text-align: center; margin-top: 30px; display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
            <button class="btn btn-primary" onclick="saveHealthSurvey()">
                <i class="fas fa-save"></i> 保存评估报告
            </button>
            <button class="btn btn-secondary" onclick="showPage('dashboard')" style="background: var(--gray); color: white;">
                <i class="fas fa-home"></i> 返回主页
            </button>
        </div>
    `;

    resultsDiv.style.display = 'block';
    resultsDiv.scrollIntoView({ behavior: 'smooth' });
}

// 保存健康評估到後端
async function saveHealthSurvey() {
    if (!currentSurveyData) {
        alert('沒有評估數據可保存');
        return;
    }

    try {
        const recordData = {
            cat_id: currentSurveyData.petId,
            record_type: 'health_survey',
            result_data: JSON.stringify({
                overall_score: currentSurveyData.overallHealth,
                diet_score: currentSurveyData.dietScore,
                activity_score: currentSurveyData.activityLevel,
                weight: currentSurveyData.weight,
                recommendations: currentSurveyData.recommendations,
                timestamp: currentSurveyData.timestamp
            }),
            risk_level: 100 - currentSurveyData.overallHealth, // 風險等級與健康分數相反
            confidence: currentSurveyData.overallHealth / 100,
            notes: `健康評估報告 - 整體健康指數: ${currentSurveyData.overallHealth}%`
        };

        const result = await createHealthRecord(recordData);

        if (result.success) {
            alert('✅ 健康評估報告保存成功！');
            // 同時更新貓咪體重
            await updateCatAPI(currentSurveyData.petId, { weight: currentSurveyData.weight });
        } else {
            alert('保存失敗: ' + (result.error || '未知錯誤'));
        }
    } catch (error) {
        console.error('保存健康評估失敗:', error);
        alert('保存失敗，請檢查網絡連接');
    }
}

// 根据分数获取颜色
function getHealthColor(score) {
    if (score >= 80) return '#28a745';
    if (score >= 60) return '#ffc107';
    return '#dc3545';
}

// 生成个性化建议
function generateRecommendations(overall, diet, activity) {
    const recommendations = [];
    
    if (overall < 60) {
        recommendations.push({
            type: 'important',
            title: '需要关注',
            description: '建议尽快带猫咪去兽医处进行全面检查'
        });
    }
    
    if (diet < 70) {
        recommendations.push({
            type: 'warning',
            title: '饮食改善',
            description: '尝试更换猫粮品牌，确保食物新鲜，定时定量喂食'
        });
    }
    
    if (activity < 70) {
        recommendations.push({
            type: 'warning',
            title: '增加活动',
            description: '每天安排15-30分钟的互动游戏，使用逗猫棒等玩具激发兴趣'
        });
    }
    
    if (overall >= 80) {
        recommendations.push({
            title: '保持良好',
            description: '猫咪状态很好，请继续保持当前的养护方式'
        });
    } else if (overall >= 60) {
        recommendations.push({
            title: '小幅调整',
            description: '猫咪基本健康，建议关注饮食和活动量的改善'
        });
    }
    
    // 通用建议
    recommendations.push({
        title: '饮水提醒',
        description: '确保猫咪有充足的清洁饮水，可以考虑使用流动饮水机'
    });
    
    recommendations.push({
        title: '环境丰富',
        description: '提供猫抓板、爬架等环境设施，满足猫咪的天性需求'
    });
    
    return recommendations;
}
// 防止页面重复创建
function ensureNoDuplicatePages() {
    const pageIds = ['dashboard', 'analysis', 'pets', 'health-survey', 'hospital', 'health-detail'];
    
    pageIds.forEach(pageId => {
        const fullId = pageId + '-page';
        const existingPages = document.querySelectorAll(`#${fullId}`);
        
        if (existingPages.length > 1) {
            console.log(`🚨 发现重复的 ${fullId} 页面，数量:`, existingPages.length);
            
            // 保留第一个，删除其他的
            for (let i = 1; i < existingPages.length; i++) {
                existingPages[i].remove();
                console.log(`✅ 已删除重复的 ${fullId} 页面`);
            }
        }
    });
}
    </script>
</head>
