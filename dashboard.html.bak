                    </div>
                    
                    <div style="max-width: 500px; margin: 0 auto;">
                        <div class="form-group" style="margin-bottom: 16px;">
                            <label style="display: block; margin-bottom: 6px; font-weight: 600; color: var(--dark);">体重 (kg)</label>
